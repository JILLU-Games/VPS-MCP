{
  "name": "vps-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Permission-scoped VPS MCP with approval-gated broker operations",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development MCP_AUTH_MODE=demo node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production MCP_AUTH_MODE=production node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "broker": "NODE_ENV=production node --env-file-if-exists=.env dist/broker/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
